generator client {
  provider = "prisma-client"
  output   = "../generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Where a user stopped in a film or an episode ("continue watching").
// Name, image and URL are kept so the list renders without asking the
// playlist server again.
model WatchProgress {
  id          String   @id @default(cuid())
  itemId      String
  itemType    String
  itemName    String
  itemUrl     String
  itemImage   String?
  showId      String?
  positionSec Int
  durationSec Int
  completed   Boolean  @default(false)
  playlistId  String
  playlist    Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([playlistId, itemId, itemType])
  @@index([playlistId])
  @@index([userId, updatedAt])
  @@map("watch_progress")
}

// Pin and hide for one provider category.
// A category id is only meaningful inside one playlist and one content kind
// (live, movie, or series). The same id elsewhere is a different category.
model CategoryPreference {
  id         String   @id @default(cuid())
  categoryId String
  kind       String
  pinned     Boolean  @default(false)
  hidden     Boolean  @default(false)
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, playlistId, kind, categoryId])
  @@index([userId, playlistId, kind])
  @@map("category_preference")
}

// Single account safety switch for adult categories.
// There is no other parental-control preference to mirror, so this is the
// only lock. The default is off and existing accounts stay unchanged.
model UserSafetyPreference {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lockAdultCategories Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("user_safety_preference")
}


// A playlist-scoped, persistent snapshot of channels, movies, and series.
// Stream URLs and provider credentials are deliberately not stored here.
model CatalogSync {
  playlistId    String   @id
  playlist      Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  activeSyncId  String?
  status        String   @default("idle")
  syncedAt      DateTime?
  itemCount     Int      @default(0)
  lastError     String?
  lastAttemptAt DateTime?
  lockedUntil   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("catalog_sync")
}

model CatalogEntry {
  id             String   @id @default(cuid())
  playlistId     String
  playlist       Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  syncId         String
  kind           String
  itemId         String
  name           String
  normalizedName String
  categoryIds    String[]
  image          String?

  @@unique([playlistId, syncId, kind, itemId])
  @@index([playlistId, syncId])
  @@map("catalog_entry")
}
