{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModernIPTV Desktop Spike",
  "version": "0.0.1",
  "identifier": "dev.moderniptvplayer.desktop-spike",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ModernIPTV Desktop (spike)",
        "width": 1280,
        "height": 780,
        "minWidth": 960,
        "minHeight": 600,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["lib/*"]
  }
}
